{
  "name": "@zooui/theme-forest",
  "version": "0.4.0",
  "description": "Forest, a Zoo UI theme: a Nuxt layer that extends @zooui/nuxt with Forest's colors, page ground, typefaces (Inter and JetBrains Mono, self-hosted), accent schemes and component styling. A product extends this one layer for Zoo UI and the theme together.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zooui-dev/zooui.git",
    "directory": "packages/theme-forest"
  },
  "homepage": "https://zooui.dev",
  "bugs": {
    "url": "https://github.com/zooui-dev/zooui/issues"
  },
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "nuxt.config.ts",
    "app.config.ts",
    "assets",
    "schemes",
    "design/*.css",
    "design/*.md",
    "design/*.html"
  ],
  "exports": {
    ".": "./nuxt.config.ts",
    "./assets/css/*": "./assets/css/*",
    "./schemes/*": "./schemes/*",
    "./design/*": "./design/*"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@zooui/nuxt": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": "^4.1.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

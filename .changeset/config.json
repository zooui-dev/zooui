{
  "$schema": "https://rigsmith.dev/schemas/changeset-config.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "zooui-dev/zooui"
    }
  ],
  "baseBranch": "main",
  "access": "public",
  "node": {
    "provenance": "always"
  },
  "updateInternalDependencies": "patch",
  "ignore": [],
  "linked": [],
  "fixed": [
    [
      "@zooui/nuxt",
      "@zooui/theme-forest"
    ]
  ],
  "contributors": {
    "exclude": [
      "JohnCampionJr"
    ]
  },
  "forgeRelease": {
    "mode": "combined",
    "name": "Zoo UI ${version}",
    "tag": "v${version}"
  }
}
